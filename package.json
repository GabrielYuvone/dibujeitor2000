{
  "name": "dibujeitor-tv",
  "version": "0.1.0",
  "private": true,
  "description": "DIBUJEITOR PRO — Software de Animación Tradicional 2D (Escuela Para Animadores de Rosario)",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3001",
    "build": "npm run ffmpeg:assets && next build",
    "start": "next start -H 0.0.0.0 -p 3001",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "ffmpeg:assets": "node scripts/copy-ffmpeg.mjs",
    "guardar-github": "bash scripts/guardar-github.sh",
    "traer-github": "bash scripts/traer-github.sh"
  },
  "dependencies": {
